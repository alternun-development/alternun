# Example env for target admin

# Public API base URL
VITE_API_URL=http://localhost:8082
# Admin app environment name
VITE_APP_ENV=development
# Admin auth audience
VITE_AUTH_AUDIENCE=alternun-app
# Local Authentik development client id
VITE_AUTH_CLIENT_ID=alternun-admin-dev
# Local Authentik issuer URL (the production deployment supplies its own issuer)
