# Copy to .env and replace every placeholder before starting the local instance.
AUTHENTIK_IMAGE_TAG=2026.2
AUTHENTIK_SECRET_KEY=<example-local-secret>
AUTHENTIK_ERROR_REPORTING__ENABLED=false

POSTGRES_DB=authentik
POSTGRES_USER=authentik
POSTGRES_PASSWORD=<example-local-password>

AUTHENTIK_POSTGRESQL__HOST=postgres
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=<example-local-password>
